NODE_ENV=development
PORT=4000
# Set to "debug" to see per-function debug logs (secrets are never logged).
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:4000

# ---- LinkedIn webhook (challenge-response validation) ----
# App client secret from the Auth tab; required to pass "Test this URL".
LINKEDIN_CLIENT_SECRET=

# ---- MongoDB ----
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=linkedin_archive

# ---- Media storage (pluggable) ----
STORAGE_DRIVER=local
MEDIA_CONTAINER=li-archive-media
LOCAL_STORAGE_DIR=./storage
# required only when STORAGE_DRIVER=azure:
AZURE_STORAGE_CONNECTION_STRING=

# ---- Internal webhook security (YOUR secret; LinkedIn is not involved) ----
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_WEBHOOK_SECRET=
INTERNAL_WEBHOOK_MAX_SKEW_MS=300000

DEFAULT_TENANT_ID=default
