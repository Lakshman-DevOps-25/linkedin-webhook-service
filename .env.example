NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Absolute base used to build browsable media URLs (local driver serves at /media).
PUBLIC_BASE_URL=http://localhost:4000

# ---- LinkedIn (DMA Member Data Portability, 3rd party) ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/oauth/callback
LINKEDIN_SCOPE=r_dma_portability_3rd_party
LINKEDIN_API_VERSION=202312

# ---- Poller ----
CHANGELOG_POLL_INTERVAL_MS=900000
CHANGELOG_PAGE_SIZE=50

# ---- MongoDB ----
MONGO_URL=mongodb://localhost:27017
MONGO_DB=linkedin_archive

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Media storage (pluggable) ----
# 'local' for development, 'azure' for production. Switch = this line only.
STORAGE_DRIVER=local
MEDIA_CONTAINER=li-archive-media
# local driver:
LOCAL_STORAGE_DIR=./storage
# azure driver (required only when STORAGE_DRIVER=azure):
AZURE_STORAGE_CONNECTION_STRING=

# ---- Security ----
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_WEBHOOK_SECRET=
INTERNAL_WEBHOOK_MAX_SKEW_MS=300000

DEFAULT_TENANT_ID=default
