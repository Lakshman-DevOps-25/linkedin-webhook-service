{
  "name": "linkedin-webhook-archiver",
  "version": "1.0.0",
  "description": "Webhook-only archiving service: receives signed message events from internal re-emitters, verifies HMAC, normalizes, stores in MongoDB, and archives media (local or Azure). MVC architecture.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:debug": "LOG_LEVEL=debug node --watch src/server.js",
    "test:webhook": "node test/send-internal-webhook.js"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.24.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.1",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.2"
  },
  "engines": { "node": ">=20" }
}
