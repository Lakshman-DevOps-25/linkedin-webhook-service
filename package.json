{
  "name": "linkedin-archive-service",
  "version": "1.0.0",
  "description": "Compliance archiving service for LinkedIn member messages via the DMA Member Data Portability changelog (pull-based), with MongoDB persistence, Azure Blob media storage, and an internal (non-LinkedIn) webhook ingress. MVC architecture.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "seed:token": "node test/seed-token.js",
    "test:webhook": "node test/send-internal-webhook.js"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.24.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "mongoose": "^8.5.1",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.2"
  },
  "engines": { "node": ">=20" }
}
